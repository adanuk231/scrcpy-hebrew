{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scrcpy-board",
  "version": "0.1.0",
  "identifier": "com.adanuk.scrcpyboard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "board",
        "label": "main",
        "width": 396,
        "height": 660,
        "minWidth": 320,
        "minHeight": 260,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}